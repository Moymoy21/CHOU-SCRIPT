        _G.AltWorkflowIndex = _G.AltWorkflowIndex + 1
    else
        -- Boss Lock Step
        local boss = workspace:FindFirstChild("Section4") and workspace.Section4.BossMonster:FindFirstChild("EnzukaiRyu")
        if not boss or not boss:FindFirstChild("HumanoidRootPart") then
            notify("Error", "No Enzukai Boss Found", 3)
            return
        end
        
        local initialBossState = boss:GetAttribute("State")
        local distanceUnder = 30 -- Distansya mo mula sa ilalim ng boss (babaan kung gusto mo mas malapit)
        
        
        
        _G.AltNoclipConn = runService.Stepped:Connect(function()
            local charRef = player.Character
            if charRef then
                for _, part in pairs(charRef:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
        
        _G.AltBossLoopConn = runService.RenderStepped:Connect(function()
            local charRef = player.Character
            local rp = charRef and charRef:FindFirstChild("HumanoidRootPart")
            local hum = charRef and charRef:FindFirstChildOfClass("Humanoid")
            if not rp or not hum or not boss or not boss.Parent then return end
            
            local bRoot = boss:FindFirstChild("HumanoidRootPart")
            if not bRoot then return end
            
            -- [[ AUTO STATE CHANGE CHECKER ]]
            local currentBossState = boss:GetAttribute("State")
            if currentBossState ~= initialBossState then
                if _G.AltBossLoopConn then _G.AltBossLoopConn:Disconnect() _G.AltBossLoopConn = nil end
                if _G.AltNoclipConn then _G.AltNoclipConn:Disconnect() _G.AltNoclipConn = nil end
                if _G.AltFlyLoopConn then _G.AltFlyLoopConn:Disconnect() _G.AltFlyLoopConn = nil end
                
                camera.CameraType = Enum.CameraType.Custom
                
                _G.AltWorkflowIndex = 1
                
                local bv = rp:FindFirstChild("CustomFlyVelocity")
                if bv then bv:Destroy() end
                
                rp.CFrame = refugeCFrame
                rp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                rp.Anchored = false
                hum.PlatformStand = false
                
                notify("⚠️ State Changed", "Must Wait Enzukai-Ryu to Fall Before Use Again the Switcher (Ignore if Boss Dead)", 6)
                return
            end
            
            hum.PlatformStand = true
            local bv = rp:FindFirstChild("CustomFlyVelocity")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "CustomFlyVelocity"
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Parent = rp
            end
            
            -- Naka-higa (Rotated 90 deg sa X) at diretsong nakatingin paitaas sa boss
            local targetPos = bRoot.Position - Vector3.new(0, distanceUnder, 0)
            rp.CFrame = CFrame.lookAt(targetPos, bRoot.Position) * CFrame.Angles(math.rad(90), 0, 0)
            rp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            
            -- HARD CAMERA LOCK: Ni-lock sa gitna ng humanoid ng boss (Bawal i-rotate ng mouse/kamay)
            camera.CameraType = Enum.CameraType.Scriptable
            camera.CFrame = CFrame.lookAt(rp.Position - Vector3.new(0, 5, 2), bRoot.Position)
        end)
        
        notify("Boss Lock", "🔒 Locked on Enzukai-Ryu" .. _G.AltWorkflowIndex .. "/12]", 2)
        _G.AltWorkflowIndex = _G.AltWorkflowIndex + 1
        
        if _G.AltWorkflowIndex > 12 then
            _G.AltWorkflowIndex = 1
        end
    end
end)


